# optional, the real handle is read from the session
IG_USERNAME=my_handle
# cookies from a logged-in instagram.com browser tab (initial seed only;
# data/session.json takes precedence once it exists)
IG_SESSIONID=
IG_CSRFTOKEN=
IG_DS_USER_ID=

# TLS/HTTP2/header fingerprint (curl_cffi target). Match the browser family
# the session was created in: chrome | firefox | safari (or pinned, e.g. chrome150)
IG_IMPERSONATE=chrome
# Optional: exact User-Agent of that browser. Empty = UA belonging to the
# fingerprint (recommended unless the Chrome major version matches).
IG_USER_AGENT=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 12 = twice a day; values below 6 are clamped to 6
CHECK_INTERVAL_HOURS=12
PAGE_SIZE=50
PAGE_SLEEP_MIN_S=1.5
PAGE_SLEEP_MAX_S=4.0
# abort diff if fetched list deviates more than this from the official count
COUNT_TOLERANCE_PCT=3
DAILY_SUMMARY=false
TZ=Europe/Berlin
LOG_LEVEL=INFO
