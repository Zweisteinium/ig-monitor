# Mode A (collect.js + --import) needs none of the IG_* values.
# Mode B reads headers and cookies from data/request.curl (see README).
# optional fallback: the real handle is read from the session
IG_USERNAME=
# optional seed, used only without data/request.curl (incomplete cookie jar, not recommended)
IG_SESSIONID=
IG_CSRFTOKEN=
# optional: force the TLS fingerprint target (chrome | firefox | safari | chrome142 ...);
# empty = derived from the captured User-Agent
IG_IMPERSONATE=

# optional for --import / --dry-run (result is printed), required for the daemon
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# daemon only; values below 12 are clamped to 12
CHECK_INTERVAL_HOURS=24
PAGE_SLEEP_MIN_S=2.0
PAGE_SLEEP_MAX_S=6.0
# abort diff if fetched list deviates more than this from the official count
COUNT_TOLERANCE_PCT=3
DAILY_SUMMARY=false
TZ=Europe/Berlin
LOG_LEVEL=INFO
